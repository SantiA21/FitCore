# ── Etapa 1: Build ──────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

# Instalamos dependencias primero (aprovecha cache de capas)
COPY package.json package-lock.json ./
RUN npm ci

# Copiamos el resto del código y construimos
COPY . .

# La URL del backend en producción se inyecta como ARG en build time:
#   docker build --build-arg VITE_API_URL=https://api.tudominio.com .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Etapa 2: Serve con nginx ─────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Copiamos los assets compilados
COPY --from=build /app/dist /usr/share/nginx/html

# Copiamos nuestra configuración de nginx (SPA-friendly)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
