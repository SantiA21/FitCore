# Variables de entorno para Docker Compose
# Copiá este archivo como .env y completá los valores antes de levantar los contenedores.
# NUNCA commitees el .env con valores reales.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=fitcore

# ── JWT ───────────────────────────────────────────────────────────────────────
# Debe ser una cadena de al menos 32 caracteres aleatorios.
# Generá una con: openssl rand -hex 32
JWT_SECRET_KEY=cambia_esta_clave_jwt_minimo_32_chars

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# Dejá estos valores de prueba (TEST-00000000...) para operar en modo sandbox
# simulado. NUNCA pongas un access token real en este archivo ni en un entorno
# de demo público: usá el gestor de secretos del hosting para eso.
MERCADOPAGO_ACCESS_TOKEN=TEST-00000000-0000-0000-0000-000000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
