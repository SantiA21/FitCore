# Variables de entorno para Docker Compose
# Copiá este archivo como .env y completá los valores antes de levantar los contenedores.
# NUNCA commitees el .env con valores reales.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=fitcore

# ── JWT ───────────────────────────────────────────────────────────────────────
# Debe ser una cadena de al menos 32 caracteres aleatorios.
# Generá una con: openssl rand -hex 32
JWT_SECRET_KEY=cambia_esta_clave_jwt_minimo_32_chars
